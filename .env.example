# =============================================================================
# FinanceHub India — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to ".env" for local development with `vercel dev`
# (the real ".env" file is git-ignored and never committed).
#
# In production, set these under:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# None of these keys are ever sent to the browser — they are only read
# inside the serverless functions in /api, which run on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# MARKET DATA (used by api/market.js as a fallback if Yahoo Finance's
# public quote endpoint is ever rate-limited or unreachable)
# -----------------------------------------------------------------------------
# Get a free key at: https://twelvedata.com/pricing  (free tier: 800 requests/day)
# Optional — the site still works without it, using Yahoo Finance only.
TWELVE_DATA_API_KEY=

# -----------------------------------------------------------------------------
# NEWS (used by api/news.js — tried in this order, first one configured
# and successful wins; having all three configured gives the strongest
# fallback chain, but even just GNews alone is enough to launch)
# -----------------------------------------------------------------------------
# Get a free key at: https://gnews.io  (free tier: 100 requests/day)
GNEWS_API_KEY=

# Get a free key at: https://newsapi.org/register  (free tier: 100 requests/day, dev use)
NEWSAPI_KEY=

# Get a free key at: https://finnhub.io/register  (free tier: 60 calls/minute)
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# SECURITY (recommended, not strictly required)
# -----------------------------------------------------------------------------
# A random string (16+ characters) used to verify that requests to
# /api/cron-refresh-market and /api/cron-refresh-news really came from
# Vercel's Cron scheduler and not a random visitor trying to burn your
# free-tier API quota. Generate one with:
#   openssl rand -hex 16
# Vercel automatically sends this value as an Authorization header when
# it invokes your cron jobs once you set it as an env var of the same name.
CRON_SECRET=
