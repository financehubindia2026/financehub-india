{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/articles/how-to-create-a-monthly-budget",
      "destination": "/articles/personal-budget-guide",
      "permanent": true
    },
    {
      "source": "/articles/how-to-create-a-monthly-budget.html",
      "destination": "/articles/personal-budget-guide",
      "permanent": true
    }
  ],

  "cleanUrls": true,
  "trailingSlash": false
}
